# Client (public by design — safe to expose in the browser bundle)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional IANA timezone used for "today", "this week", "this month"
VITE_APP_TIMEZONE=Africa/Johannesburg

# Server only (Vercel serverless functions). NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Long random string, e.g. `openssl rand -hex 32`. Changing it invalidates the stored PIN.
PIN_PEPPER=replace-with-long-random-string
# Optional: first-run PIN (4-8 digits). Defaults to 0000. Must be changed on first login.
INITIAL_PIN=
